{
  "mcpServers": {
    "serena": {
      "name": "Serena Code Intelligence",
      "type": "STDIO",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project",
        ".",
        "--context",
        "desktop-app",
        "--mode",
        "interactive",
        "--mode",
        "editing",
        "--transport",
        "stdio"
      ],
      "env": {
        "SERENA_PROJECT_ROOT": ".",
        "SERENA_CONTEXT": "RdLn_MVP_Stream"
      },
      "disabled": false,
      "description": "Serena provides semantic code understanding and editing capabilities for the RdLn project",
      "autoApprove": [
        "find_symbol",
        "find_referencing_symbols", 
        "get_symbols_overview",
        "read_file",
        "list_dir",
        "search_for_pattern",
        "onboarding",
        "initial_instructions"
      ],
      "requireApproval": [
        "replace_symbol_body",
        "create_text_file",
        "execute_shell_command",
        "replace_lines",
        "insert_at_line",
        "delete_lines"
      ]
    }
  }
}