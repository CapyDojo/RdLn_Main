{
  "name": "rdln",
  "private": true,
  "version": "0.5.15",
  "type": "module",
  "description": "RdLn™ - Professional document comparison tool with OCR capabilities",
  "author": "RdLn Team",
  "copyright": "Copyright (c) 2025 RdLn Team. All rights reserved.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <21"
  },
  "main": "src-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npx vite build",
    "build:web": "npx vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:report": "node scripts/coverage-report.js",
    "test:coverage:open": "npm run test:coverage && open coverage/index.html",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.ocr.config.ts tests/integration",
    "test:performance": "vitest run --config vitest.ocr.config.ts tests/performance",
    "test:accuracy": "vitest run --config vitest.ocr.config.ts tests/accuracy",
    "test:ocr": "vitest run --config vitest.ocr.config.ts",
    "test:real": "vitest run tests/real-ocr.test.ts --no-coverage",
    "test:watch": "vitest --watch",
    "test:filing-cabinet": "ts-node tests/unified-filing-cabinet/test-runner.ts",
    "test:filing-cabinet:visual": "ts-node tests/unified-filing-cabinet/test-runner.ts visual",
    "test:filing-cabinet:integration": "ts-node tests/unified-filing-cabinet/test-runner.ts integration",
    "test:filing-cabinet:coverage": "vitest run tests/visual-regression/unified-filing-cabinet.test.tsx tests/integration/filing-cabinet-coordination.test.tsx --coverage",
    "test:filing-cabinet:report": "ts-node tests/unified-filing-cabinet/test-runner.ts && echo 'Reports generated in tests/unified-filing-cabinet/reports/'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:dev": "concurrently \"npm run dev\" \"electron src-electron/main.cjs\"",
    "process:electron-html": "node scripts/process-electron-html.js",
    "electron:build": "ELECTRON_BUILD=true npm run build && npm run process:electron-html && electron-builder --config src-electron/builder.config.cjs",
    "electron:build:win": "set ELECTRON_BUILD=true && npm run build && npm run process:electron-html && electron-builder --win --config src-electron/builder.config.cjs",
    "electron:run": "dist-electron-new/win-unpacked/RdLn.exe",
    "electron:build:mac": "ELECTRON_BUILD=true npm run build && npm run process:electron-html && electron-builder --mac --config src-electron/builder.config.cjs",
    "electron:build:linux": "ELECTRON_BUILD=true npm run build && npm run process:electron-html && electron-builder --linux --config src-electron/builder.config.cjs",
    "download:fonts": "node scripts/download-fonts.js",
    "download:tesseract": "node scripts/download-tesseract-assets.js",
    "copy:tesseract": "node scripts/copy-tesseract-assets.js",
    "download:all": "npm run download:fonts && npm run download:tesseract",
    "prepare:tauri": "npm run copy:tesseract && npm run build",
    "prepare:electron": "npm run download:all && npm run build",
    "setup:electron": "node scripts/setup-electron.js",
    "mcp": "npx @playwright/mcp@latest",
    "check": "npm run lint && npm run test:run",
    "check:strict": "npm run lint -- --max-warnings=0 && npm run test:run",
    "smoke": "vitest run tests/pages tests/services --reporter=verbose",
    "pack:win": "npm run electron:build:win"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "@popperjs/core": "^2.11.8",
    "@tauri-apps/plugin-fs": "^2.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.344.0",
    "mammoth": "^1.10.0",
    "opencc-js": "^1.0.5",
    "posthog-js": "^1.260.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-popper": "^2.3.0",
    "sharp": "^0.34.2",
    "tesseract.js": "^5.0.4",
    "xmlbuilder2": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/mcp": "^0.0.34",
    "@playwright/test": "^1.54.2",
    "@tauri-apps/api": "^2.7.0",
    "@tauri-apps/cli": "^2.7.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.18",
    "canvas": "^3.1.2",
    "concurrently": "^8.2.2",
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.35",
    "sass": "^1.90.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
